# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=voipmonitor/vllm:kimi-k3-hh-native-topk-base-20260804@sha256:3ce9dfad1f684a76687095d80e49c96de42b008f7141587e7620c068f8073155
FROM ${BASE_IMAGE}

ARG VLLM_REPO=https://github.com/local-inference-lab/vllm.git
ARG VLLM_REF=pr/kimi-k3-dspark-dcp16-perf-20260806
ARG VLLM_COMMIT=6e700c9e1fcffadef06f701447b5a9eb42a61ac0
ARG SPARKINFER_REPO=https://github.com/local-inference-lab/b12x.git
ARG SPARKINFER_REF=pr/kimi-k3-dspark-dcp16-perf-20260806
ARG SPARKINFER_COMMIT=a569f6e1b06fa0423252cad94734fe424d200072
ARG DOCKER_COMMIT=unknown

ENV TORCH_CUDA_ARCH_LIST=12.0a \
    NVCC_THREADS=4 \
    PYTHONPATH=/opt/kimi-k3-hh/vllm:/opt/kimi-k3-hh/sparkinfer \
    SPARKINFER_DIR=/opt/kimi-k3-hh/sparkinfer \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

RUN set -eux; \
    mkdir -p /opt/kimi-k3-hh; \
    if [ -d /opt/kimi-k3-hh/vllm/.git ]; then \
      git -C /opt/kimi-k3-hh/vllm fetch --filter=blob:none origin "${VLLM_REF}"; \
    else \
      git clone --filter=blob:none --single-branch --branch "${VLLM_REF}" \
        "${VLLM_REPO}" /opt/kimi-k3-hh/vllm; \
    fi; \
    git -C /opt/kimi-k3-hh/vllm checkout --detach "${VLLM_COMMIT}"; \
    test "$(git -C /opt/kimi-k3-hh/vllm rev-parse HEAD)" = "${VLLM_COMMIT}"; \
    if [ -d /opt/kimi-k3-hh/sparkinfer/.git ]; then \
      git -C /opt/kimi-k3-hh/sparkinfer fetch --filter=blob:none origin \
        "${SPARKINFER_REF}"; \
    else \
      git clone --filter=blob:none --single-branch --branch "${SPARKINFER_REF}" \
        "${SPARKINFER_REPO}" /opt/kimi-k3-hh/sparkinfer; \
    fi; \
    git -C /opt/kimi-k3-hh/sparkinfer checkout --detach "${SPARKINFER_COMMIT}"; \
    test "$(git -C /opt/kimi-k3-hh/sparkinfer rev-parse HEAD)" = "${SPARKINFER_COMMIT}"

# The preserved CUDA image contains the full vLLM ABI-compatible extensions.
# Build only the three small HH Kimi-K3 compatibility modules from PR #238.
RUN set -eux; \
    cd /opt/kimi-k3-hh/vllm; \
    for spec in cache:CACHE kda:KDA activation:ACTIVATION; do \
      name="${spec%%:*}"; \
      flag="${spec##*:}"; \
      build="/tmp/kimi-k3-${name}-ops"; \
      /opt/venv/bin/cmake -S . -B "${build}" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=75 \
        -DVLLM_TARGET_DEVICE=cuda \
        -DVLLM_PYTHON_EXECUTABLE=/opt/venv/bin/python \
        -DNVCC_THREADS=4 \
        "-DVLLM_KIMI_K3_${flag}_OPS_ONLY=ON"; \
      /opt/venv/bin/cmake --build "${build}" --parallel 16; \
      cp "${build}/_kimi_k3_${name}_ops.abi3.so" \
        "/opt/kimi-k3-hh/vllm/vllm/_kimi_k3_${name}_ops.abi3.so"; \
      rm -rf "${build}"; \
    done; \
    site=/opt/venv/lib/python3.12/site-packages/vllm; \
    find "${site}" -type f -name '*.so' -exec sh -c '\
      site="$1"; shift; \
      for src do \
        rel="${src#${site}/}"; \
        dst="/opt/kimi-k3-hh/vllm/vllm/${rel}"; \
        if [ ! -e "${dst}" ]; then \
          mkdir -p "$(dirname "${dst}")"; \
          ln -s "${src}" "${dst}"; \
        fi; \
      done \
    ' sh "${site}" {} +; \
    test -L /opt/kimi-k3-hh/vllm/vllm/_C_stable_libtorch.abi3.so; \
    test -L /opt/kimi-k3-hh/vllm/vllm/_moe_C_stable_libtorch.abi3.so; \
    test -L /opt/kimi-k3-hh/vllm/vllm/_qutlass_C.abi3.so; \
    /opt/venv/bin/python -c \
      'import torch, vllm._moe_C_stable_libtorch, vllm._kimi_k3_cache_ops, vllm._kimi_k3_kda_ops, vllm._kimi_k3_activation_ops; from sparkinfer.comm.pcie.pcie_dcp_a2a import SUPPORTED_WORLD_SIZES; assert "is_padding" in str(torch.ops._moe_C.topk_sigmoid.default._schema); assert SUPPORTED_WORLD_SIZES == (2, 4, 8, 16)'; \
    for launcher in \
      serve-kimi-k3-full-mxfp4-dcp16-1m-no-dspark.sh \
      serve-kimi-k3-full-mxfp4-dcp16-1m-no-dspark-batch8.sh \
      serve-kimi-k3-full-mxfp4-dcp8-1m-no-dspark-optimized.sh \
      serve-kimi-k3-full-mxfp4-dspark7-dcp16-1m-kda-mxfp8.sh \
      serve-kimi-k3-full-mxfp4-dspark7-dcp16-1m-hierarchical-bf16x2.sh \
      serve-kimi-k3-full-mxfp4-dspark7-dcp8-1m.sh; do \
      test -x "/opt/kimi-k3-hh/vllm/${launcher}"; \
    done

WORKDIR /opt/kimi-k3-hh/vllm

LABEL org.opencontainers.image.title="Kimi-K3 HH TP16 DCP8/DCP16 runtime" \
      org.opencontainers.image.description="Immutable HH vLLM PR 238 plus SparkInfer PR 118 with DSpark and optimized no-DSpark launch profiles" \
      org.opencontainers.image.source="https://github.com/local-inference-lab/blackwell-llm-docker/tree/build/kimi-k3-hh-runtime-20260805" \
      org.opencontainers.image.created="2026-08-05T00:00:00Z" \
      org.opencontainers.image.version="2026-08-05" \
      org.opencontainers.image.revision="${DOCKER_COMMIT}" \
      local-inference-lab.docker.commit="${DOCKER_COMMIT}" \
      local-inference-lab.runtime.base-digest="sha256:3ce9dfad1f684a76687095d80e49c96de42b008f7141587e7620c068f8073155" \
      local-inference-lab.kimi-k3.moe-native-sha256="33717a2c4b346ba02470db6a4b2ba1998804d1cf1b1527004ce375f1e3de429b" \
      local-inference-lab.vllm.ref="codex/hh-kimi-k3-dspark-dcp16-20260804" \
      local-inference-lab.vllm.commit="6e700c9e1fcffadef06f701447b5a9eb42a61ac0" \
      local-inference-lab.vllm.pr="238" \
      local-inference-lab.sparkinfer.ref="codex/hh-kimi-k3-dcp16-20260804" \
      local-inference-lab.sparkinfer.commit="a569f6e1b06fa0423252cad94734fe424d200072" \
      local-inference-lab.sparkinfer.pr="118"

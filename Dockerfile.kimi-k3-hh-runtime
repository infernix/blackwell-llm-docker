# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG BASE_IMAGE_ID
ARG VLLM_REPO
ARG VLLM_REF
ARG VLLM_COMMIT
ARG VLLM_PATCH_FILE
ARG VLLM_PATCH_SHA256
ARG VLLM_INTEGRATION_TREE
ARG VLLM_INTEGRATION_LOCK_SHA256
ARG VLLM_PRS
ARG B12X_REPO
ARG B12X_REF
ARG B12X_COMMIT
ARG B12X_PATCH_FILE
ARG B12X_PATCH_SHA256
ARG B12X_INTEGRATION_TREE
ARG B12X_INTEGRATION_LOCK_SHA256
ARG B12X_PRS
ARG RELEASE_NAME
ARG RELEASE_DATE
ARG DOCKER_COMMIT
ARG CACHE_FINGERPRINT

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Every compiler and runtime cache is scoped by both composed source trees.
# Serving profiles use separate host volumes so modules compiled for a
# speculative worker cannot shadow modules compiled for the target-only path.
ENV LOCAL_INFERENCE_CACHE_FINGERPRINT=${CACHE_FINGERPRINT} \
    XDG_CACHE_HOME=/cache/jit/${CACHE_FINGERPRINT} \
    VLLM_CACHE_ROOT=/cache/jit/${CACHE_FINGERPRINT}/vllm \
    VLLM_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/vllm \
    TRITON_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/triton \
    TORCH_EXTENSIONS_DIR=/cache/jit/${CACHE_FINGERPRINT}/torch-extensions \
    TORCHINDUCTOR_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/torchinductor \
    VLLM_FLASHINFER_AUTOTUNE_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/flashinfer-autotune \
    TVM_FFI_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/tvm-ffi \
    TVM_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/tvm \
    TILELANG_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/tilelang \
    CUTE_DSL_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/cute-dsl \
    B12X_CUTE_COMPILE_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/b12x/cute \
    B12X_COMPILE_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/b12x/compile \
    SPARKINFER_COMPILE_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/b12x/compile \
    DG_JIT_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/deep-gemm \
    MM_SPARSE_ATTN_AOT_CACHE=/cache/jit/${CACHE_FINGERPRINT}/minfer/mm-sparse-attn \
    MINFER_FMHA_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/minfer/fmha-sm120 \
    NUMBA_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/numba \
    CUDA_CACHE_PATH=/cache/jit/${CACHE_FINGERPRINT}/cuda \
    CUPY_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/cupy \
    HF_HOME=/root/.cache/huggingface

ENV TORCH_CUDA_ARCH_LIST=12.0a \
    NVCC_THREADS=4 \
    PYTHONPATH=/opt/kimi-k3-hh/vllm:/opt/kimi-k3-hh/b12x \
    SPARKINFER_DIR=/opt/kimi-k3-hh/b12x \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    CUDA_DEVICE_ORDER=PCI_BUS_ID \
    VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4 \
    NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4 \
    NCCL_IB_DISABLE=1 \
    NCCL_P2P_LEVEL=SYS \
    NCCL_P2P_DISABLE=0 \
    NCCL_CUMEM_ENABLE=0 \
    NCCL_PROTO=LL,LL128,Simple

RUN mkdir -p "/cache/jit/${CACHE_FINGERPRINT}"
COPY patches /tmp/release-patches

# Each source directory starts at the base commit recorded in its lock. The
# binary patch hash and resulting Git tree must both match before compilation.
RUN set -eux; \
    mkdir -p /opt/kimi-k3-hh; \
    compose_source() { \
      component="$1"; destination="$2"; repository="$3"; reference="$4"; \
      commit="$5"; patch_file="$6"; patch_sha256="$7"; expected_tree="$8"; \
      git clone --filter=blob:none --no-checkout "${repository}" "${destination}"; \
      git -C "${destination}" fetch --filter=blob:none origin "${reference}"; \
      git -C "${destination}" checkout --detach "${commit}"; \
      test "$(git -C "${destination}" rev-parse HEAD)" = "${commit}"; \
      patch_path="/tmp/release-patches/${patch_file}"; \
      test -f "${patch_path}"; \
      echo "${patch_sha256}  ${patch_path}" | sha256sum -c -; \
      if test -s "${patch_path}"; then \
        git -C "${destination}" apply "${patch_path}"; \
      fi; \
      git -C "${destination}" add -A; \
      actual_tree="$(git -C "${destination}" write-tree)"; \
      test "${actual_tree}" = "${expected_tree}" || { \
        echo "${component} tree ${actual_tree} does not match ${expected_tree}" >&2; \
        exit 1; \
      }; \
    }; \
    compose_source vllm /opt/kimi-k3-hh/vllm \
      "${VLLM_REPO}" "${VLLM_REF}" "${VLLM_COMMIT}" \
      "${VLLM_PATCH_FILE}" "${VLLM_PATCH_SHA256}" "${VLLM_INTEGRATION_TREE}"; \
    compose_source b12x /opt/kimi-k3-hh/b12x \
      "${B12X_REPO}" "${B12X_REF}" "${B12X_COMMIT}" \
      "${B12X_PATCH_FILE}" "${B12X_PATCH_SHA256}" "${B12X_INTEGRATION_TREE}"; \
    rm -rf /tmp/release-patches

WORKDIR /opt/kimi-k3-hh/vllm

# Native vLLM extensions are compiled from the composed HH tree. This prevents
# a Python source tree from importing extension modules built for the GG base.
RUN set -eux; \
    /opt/venv/bin/cmake -S . -B /tmp/vllm-extensions -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=75 \
      -DVLLM_TARGET_DEVICE=cuda \
      -DVLLM_PYTHON_EXECUTABLE=/opt/venv/bin/python \
      -DNVCC_THREADS=4; \
    /opt/venv/bin/cmake --build /tmp/vllm-extensions --parallel 48; \
    find /tmp/vllm-extensions -name '*.abi3.so' > /tmp/vllm-extension-list; \
    extension_count=0; \
    while IFS= read -r extension; do \
      case "${extension}" in \
        */vllm-flash-attn/*) destination=/opt/kimi-k3-hh/vllm/vllm/vllm_flash_attn ;; \
        */_deps/*) continue ;; \
        *) destination=/opt/kimi-k3-hh/vllm/vllm ;; \
      esac; \
      cp "${extension}" "${destination}/$(basename "${extension}")"; \
      extension_count=$((extension_count + 1)); \
    done < /tmp/vllm-extension-list; \
    test "${extension_count}" -ge 10; \
    rm -rf /tmp/vllm-extensions /tmp/vllm-extension-list

# The three public entrypoints share one target model runtime. DSpark uses a
# BF16 draft with online MXFP8 target KDA projections; DFlash quantizes draft
# linear weights online to MXFP8 while retaining its fused QKV projection.
RUN set -eux; \
    /opt/venv/bin/python -c \
      'import torch, vllm._moe_C_stable_libtorch, vllm._kimi_k3_cache_ops, vllm._kimi_k3_kda_ops, vllm._kimi_k3_activation_ops; import b12x; assert b12x.__file__.startswith("/opt/kimi-k3-hh/b12x/"), b12x.__file__; from b12x.comm.pcie.pcie_dcp_a2a import SUPPORTED_WORLD_SIZES; assert "is_padding" in str(torch.ops._moe_C.topk_sigmoid.default._schema); assert SUPPORTED_WORLD_SIZES == (2, 4, 8, 16)' ; \
    /opt/venv/bin/python -c \
      'from b12x.comm.pcie.pcie_allreduce import recommended_max_bytes; assert recommended_max_bytes(16, default=86016) == 163840' ; \
    test -f /opt/kimi-k3-hh/b12x/b12x/attention/dense_mla/__init__.py; \
    test -f /opt/kimi-k3-hh/b12x/b12x/comm/pcie/_dcp_a2a_cute.py; \
    test -f /opt/kimi-k3-hh/b12x/b12x/comm/pcie/_island_rs_cute.py; \
    for launcher in \
      serve-kimi-k3-full-mxfp4-dcp16-1m-no-dspark.sh \
      serve-kimi-k3-full-mxfp4-dspark7-dcp16-1m-kda-mxfp8.sh \
      serve-kimi-k3-full-mxfp4-dflash-dcp16-1m.sh; do \
      test -x "${launcher}"; \
      bash -n "${launcher}"; \
    done

COPY --chmod=0755 launchers/serve-kimi-k3-nospec /usr/local/bin/serve-kimi-k3-nospec
COPY --chmod=0755 launchers/serve-kimi-k3-dspark /usr/local/bin/serve-kimi-k3-dspark
COPY --chmod=0755 launchers/serve-kimi-k3-dflash /usr/local/bin/serve-kimi-k3-dflash

LABEL org.opencontainers.image.title="Kimi-K3 HH TP16 runtime" \
      org.opencontainers.image.description="Pinned HH and b12x source composition for Kimi-K3 full-MXFP4 no-spec, DSpark, and DFlash serving" \
      org.opencontainers.image.source="https://github.com/local-inference-lab/blackwell-llm-docker" \
      org.opencontainers.image.version="${RELEASE_DATE}" \
      org.opencontainers.image.revision="${DOCKER_COMMIT}" \
      local-inference.release.name="${RELEASE_NAME}" \
      local-inference.docker.commit="${DOCKER_COMMIT}" \
      local-inference.runtime.base-image="${BASE_IMAGE}" \
      local-inference.runtime.base-id="${BASE_IMAGE_ID}" \
      local-inference.cache.fingerprint="${CACHE_FINGERPRINT}" \
      local-inference.vllm.repo="${VLLM_REPO}" \
      local-inference.vllm.branch="${VLLM_REF}" \
      local-inference.vllm.commit="${VLLM_COMMIT}" \
      local-inference.vllm.integration.base_commit="${VLLM_COMMIT}" \
      local-inference.vllm.integration.prs="${VLLM_PRS}" \
      local-inference.vllm.integration.tree="${VLLM_INTEGRATION_TREE}" \
      local-inference.vllm.patch_file="${VLLM_PATCH_FILE}" \
      local-inference.vllm.patch_sha256="${VLLM_PATCH_SHA256}" \
      local-inference.vllm.integration.lock_sha256="${VLLM_INTEGRATION_LOCK_SHA256}" \
      local-inference.b12x.repo="${B12X_REPO}" \
      local-inference.b12x.branch="${B12X_REF}" \
      local-inference.b12x.commit="${B12X_COMMIT}" \
      local-inference.b12x.integration.base_commit="${B12X_COMMIT}" \
      local-inference.b12x.integration.prs="${B12X_PRS}" \
      local-inference.b12x.integration.tree="${B12X_INTEGRATION_TREE}" \
      local-inference.b12x.patch_file="${B12X_PATCH_FILE}" \
      local-inference.b12x.patch_sha256="${B12X_PATCH_SHA256}" \
      local-inference.b12x.integration.lock_sha256="${B12X_INTEGRATION_LOCK_SHA256}"

# Inherited GG labels use a different source composition. These compatibility
# keys are overwritten so inventory tools cannot report the base as active.
LABEL local-inference.sparkinfer.repo="${B12X_REPO}" \
      local-inference.sparkinfer.branch="${B12X_REF}" \
      local-inference.sparkinfer.commit="${B12X_COMMIT}" \
      local-inference.sparkinfer.integration.base_commit="${B12X_COMMIT}" \
      local-inference.sparkinfer.integration.prs="${B12X_PRS}" \
      local-inference.sparkinfer.integration.tree="${B12X_INTEGRATION_TREE}" \
      local-inference.sparkinfer.patch_file="${B12X_PATCH_FILE}" \
      local-inference.sparkinfer.patch_sha256="${B12X_PATCH_SHA256}" \
      local-inference.sparkinfer.integration.lock_sha256="${B12X_INTEGRATION_LOCK_SHA256}"

ENTRYPOINT ["/usr/local/bin/serve-kimi-k3-dspark"]

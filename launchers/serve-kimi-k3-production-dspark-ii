#!/usr/bin/env bash
# Serve the official multimodal Kimi-K3 MXFP4 target with the Inferact DSpark
# draft and an external LMCache process. Set LMCACHE_MODE=off for an uncached
# control, or LMCACHE_MODE=disk with a persistent /cache mount for an L2 tier.
set -euo pipefail

export LMCACHE_MODE="${LMCACHE_MODE:-ram}"
export LMCACHE_L1_GB="${LMCACHE_L1_GB:-32}"
# Kimi-K3 DCP16 exposes 768-token scheduler blocks and 12,288-token MLA
# transfer groups. LMCache chunks must preserve both granularities.
export LMCACHE_CHUNK_SIZE="${LMCACHE_CHUNK_SIZE:-12288}"
export ENABLE_PREFIX_CACHING="${ENABLE_PREFIX_CACHING:-1}"
export ENABLE_VISION="${ENABLE_VISION:-1}"
export TP_SIZE="${TP_SIZE:-16}"
export DCP_SIZE="${DCP_SIZE:-16}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-1000000}"
export MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-1024}"
export KV_CACHE_MEMORY_BYTES="${KV_CACHE_MEMORY_BYTES:-1325000000}"

exec /usr/local/bin/lmcache-mp-wrapper.sh \
  /usr/local/bin/serve-kimi-k3-full-mxfp4-dspark-ii \
  "$@"

+class MixedTrellisTier(Protocol):
+    """Prepared Trellis tier fields consumed by the mixed launch."""
+
+    intermediate_rotations: torch.Tensor
+    gate_suh: torch.Tensor
+    up_suh: torch.Tensor
+    down_svh: torch.Tensor
+    w13: torch.Tensor
+    w2: torch.Tensor

+        assert len(calls) == 1
+        parameters = [argument.arg for argument in target.args.args][1:]
+        arguments = [ast.unparse(argument) for argument in calls[0].args]
+        assert len(arguments) == len(parameters)
+        bound = dict(zip(parameters, arguments, strict=True))

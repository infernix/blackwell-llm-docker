+def warmup_mixed_trellis_route_pack(
+    launch: MixedTrellisCompileResult,
+    buffers: MixedTrellisBuffers,
+    *,
+    expert_map: torch.Tensor,
+) -> int:
+    """Materialize every route-pack specialization reachable by ``launch``.

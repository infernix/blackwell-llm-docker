+def _fits(
+    *,
+    tile_k: int,
+    tile_n: int,
+    cta_threads: int,
+    allow_qualified_fc2_tile: bool = False,
+) -> bool:
+    return _candidate_tile_fits(
+        problem_n=4096,
+        problem_k=512,
+        cta_m_blocks=1,
+        tile_n=tile_n,
+        tile_k=tile_k,
+        cta_threads=cta_threads,
+        max_shared_mem=1 << 30,
+        scale_format="e8m0_k32",
+        weight_layout="modelopt",
+        weight_bits=4,
+        allow_qualified_fc2_tile=allow_qualified_fc2_tile,
+    )

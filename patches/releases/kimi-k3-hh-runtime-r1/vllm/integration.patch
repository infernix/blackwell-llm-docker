+def test_k3_dspark_window_group_preserves_target_and_kda_layers(monkeypatch):
+    """K3 + bounded DSpark uses the compact generic hybrid-cache layout."""
+    target = MLAAttentionSpec(
+        block_size=16,
+        num_kv_heads=1,
+        head_size=576,
+        dtype=torch.float8_e4m3fn,

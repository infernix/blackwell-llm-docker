+        slab9: cute.Pointer,
+        slab10: cute.Pointer,
+        slab11: cute.Pointer,
+        slab12: cute.Pointer,
+        slab13: cute.Pointer,
+        slab14: cute.Pointer,
+        slab15: cute.Pointer,
+        input_ptr: cute.Pointer,
+        output_ptr: cute.Pointer,
+        stage_offset: Int64,
+        part_offset: Int64,
+        final_offset: Int64,
+        quarter_capacity: Int64,
+        elements: Int64,
+        blocks: Int32,
+        stream: cuda.CUstream,
+    ) -> None:
+        self.kernel(
+            slab0,
+            slab1,
+            slab2,
+            slab3,
+            slab4,
+            slab5,
+            slab6,
+            slab7,
+            slab8,
+            slab9,
+            slab10,
+            slab11,
+            slab12,
+            slab13,
+            slab14,
+            slab15,
+            input_ptr,
+            output_ptr,
+            stage_offset,
+            part_offset,
+            final_offset,
+            quarter_capacity,
+            elements,
+        ).launch(
+            grid=(blocks, 1, 1),
+            block=[self._threads, 1, 1],
+            cluster=(1, 1, 1),
+            stream=stream,
+        )
+
+    @cute.kernel
+    def kernel(

+    local_router = torch.zeros(
+        (pair_batch, local_router_width),
+        device=device,
+        dtype=torch.float32,
+    )
+    warmed = 0
+    paired = _try_b12x_dcp_all_gather_pair(
+        local_down,
+        local_router,
+        projection_group,
+        max_batch_size=_KIMI_PAIRED_MAX_BATCH_SIZE,
+    )

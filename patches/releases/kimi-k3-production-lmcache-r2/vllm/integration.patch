+
+    def gather(local_q, actual_group, *, max_batch_size, output_head_dim, out):
+        assert actual_group is group
+        assert max_batch_size == 16
+        assert output_head_dim == 512
+        assert out.shape == (batch, 48, 576)
+        calls.append("gather")

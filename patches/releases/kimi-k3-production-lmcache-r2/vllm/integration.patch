+    topk_weights = torch.empty(
+        (rows, _KIMI_ROUTER_TOPK),
+        device=router_logits.device,
+        dtype=torch.float32,
+    )
+    topk_ids = torch.empty(
+        (rows, _KIMI_ROUTER_TOPK),
+        device=router_logits.device,
+        dtype=torch.int32,
+    )
+    kimi_topk16(
+        router_logits,
+        correction_bias,
+        topk_weights,
+        topk_ids,
+    )

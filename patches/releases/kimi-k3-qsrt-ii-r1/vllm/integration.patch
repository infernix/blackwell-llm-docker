+      static_cast<int>(rows), kimi_topk16::kThreads, 0, stream>>>(
+      logits.data_ptr<float>(),
+      bias.data_ptr<float>(),
+      out_weights.data_ptr<float>(),
+      out_indices.data_ptr<int>(),
+      pad_ptr,
+      renormalize,
+      static_cast<float>(routed_scaling_factor));
